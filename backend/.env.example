# ==========================================
# Base de datos PostgreSQL
# ==========================================
DATABASE_URL=postgresql+psycopg://usuario:password@localhost:5432/communitylab

# ==========================================
# Autenticación / JWT
# ==========================================
JWT_SECRET_KEY=REPLACE_WITH_A_SECURE_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==========================================
# Discord
# ==========================================
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_IDS=

# ==========================================
# Oracle Cloud Infrastructure - Object Storage
# ==========================================
OCI_CONFIG_FILE=
OCI_CONFIG_PROFILE=DEFAULT
OCI_NAMESPACE=
OCI_BUCKET_NAME=

# LinkedIn OAuth - CloudEdTech
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://cloudedtech.netlify.app/auth/linkedin/callback
LINKEDIN_SCOPES=w_member_social
